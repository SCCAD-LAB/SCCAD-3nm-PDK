  default_operating_conditions : tt_0p80v_0p80v_25c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 0.314814814814815;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(RF_128X46M4B1) {
    area : 378.9812;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    /* Peak current of all modes. */
    peak_current : 68.564235;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 10.261888;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.0005373;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    pin(CENY) {
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      max_capacitance : 0.100000;
      max_transition : 0.399960;
      timing() {
        related_pin : CEN;
