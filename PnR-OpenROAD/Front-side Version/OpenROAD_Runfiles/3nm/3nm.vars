# 3nm GAA FSPR OpenROAD platform variables.
# Paths derive from PDK_ROOT.

set platform "3nm"

if {![info exists ::env(PDK_ROOT)]} {
  puts "ERROR: please set PDK_ROOT to the USC-3N-2D repository root before sourcing this script"
  exit 1
}
set pdk_root [file normalize $::env(PDK_ROOT)]

set openroad_pnr_dir [file join $pdk_root "PnR-OpenROAD/Front-side Version"]

set tech_lef [file join $openroad_pnr_dir "TECH-LEF/3nm_GAA_FSPR.tech.lef"]
set std_cell_lef [file join $openroad_pnr_dir "LEF/3nm_GAA_FSPR.lef"]
set extra_lef {}

set liberty_file [file join $openroad_pnr_dir "LIB/3nm_GAA_FSPR_rvt_nldm.lib"]
set extra_liberty {}

set site "coreSite"

set pdn_cfg "3nm/3nm.pdn.tcl"
set tracks_file "3nm/3nm.tracks"

set io_placer_hor_layer M2
set io_placer_ver_layer M3

# No tap/tie/filler cells are present in the supplied LEF/lib.
set tapcell_args ""
set global_place_density 0.9
set global_place_density_penalty 8e-5
set global_place_pad 2
set detail_place_pad 1

set macro_place_halo {1 1}
set macro_place_channel {10 10}

set layer_rc_file [file join $openroad_pnr_dir "RC/setRC.tcl"]
set wire_rc_layer "M3"
set wire_rc_layer_clk "M6"
set tielo_port ""
set tiehi_port ""
set dont_use {}
set tie_separation 5
set cts_buffer "BUFx4"
set cts_cluster_diameter 100
set filler_cells ""

set global_routing_layers M1-M9
set global_routing_clock_layers M6-M9
set global_routing_layer_adjustments {
  {M1 0.5}
  {M2 0.5}
  {M3 0.5}
  {M4 0.5}
  {M5 0.5}
  {M6 0.5}
  {M7 0.5}
  {M8 0.5}
  {M9 0.5}
}

set min_routing_layer M1
set max_routing_layer M9

# Keep empty by default because setRC.tcl already provides wire/via RC.
set rcx_rules_file ""
